<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════
         1. URL REWRITING — React Router + SEO Redirects
         Order matters. Each rule below only runs if the
         ones above it didn't already redirect the request.
    ═══════════════════════════════════════════════════ -->
    <rewrite>
      <rules>

        <!-- Rule 1: Force HTTPS (HTTP → HTTPS) -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 2: Remove WWW (www.qllmsoft.com → qllmsoft.com) -->
        <rule name="Remove WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.qllmsoft\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://qllmsoft.com/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- ═══ NEW Rule 3: Force lowercase URLs ═══
             Fixes: /About, /About.html, /Contact, /Contact.html,
             /Services, /Projects, etc. all collapsing into one
             canonical lowercase URL instead of existing as
             separate duplicate URLs to Google.
             MUST run before the trailing-slash and .html-strip
             rules below, so a URL like /About.html becomes
             /about.html first, then gets stripped to /about
             by Rule 5 — one clean destination, not two hops
             landing on different casings. -->
        <rule name="Lowercase URLs" stopProcessing="true">
          <match url=".*[A-Z].*" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="{ToLower:{URL}}" redirectType="Permanent" />
        </rule>

        <!-- Rule 4: Remove trailing slash (except root /) -->
        <!-- /hire-react-developers-pakistan/ → /hire-react-developers-pakistan -->
        <rule name="Remove Trailing Slash" stopProcessing="true">
          <match url="(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 5: Remove .html extension -->
        <!-- /about.html → /about -->
        <rule name="Remove HTML Extension" stopProcessing="true">
          <match url="^(.*?)\.html$" />
          <action type="Redirect" url="/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- ═══ NEW Rule 6: Retire the old /blog-post/ URL structure ═══
             VERIFIED against the actual blogPostsData source — several
             slugs were renamed during the /blog-post/ → /blog/ migration,
             not just re-prefixed. Two old URLs have no current equivalent
             at all and fall back to the blog index. -->
        <rule name="RedirectOldBlogPost1" stopProcessing="true">
          <match url="^blog-post/legacy-system-modernization-cost-in-2026/?$" />
          <action type="Redirect" url="/blog/legacy-system-modernization-without-downtime-or-data-loss" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost2" stopProcessing="true">
          <match url="^blog-post/mobile-app-devsecops/?$" />
          <action type="Redirect" url="/blog/mobile-app-devsecops-in-2026" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost3" stopProcessing="true">
          <match url="^blog-post/role-based-access-ecommerce-operations/?$" />
          <action type="Redirect" url="/blog/role-based-access-problems-why-teams-break-systems" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost4" stopProcessing="true">
          <match url="^blog-post/how-we-build-secure-web-apps/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost5" stopProcessing="true">
          <match url="^blog-post/what-makes-a-great-mobile-app/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>

        <!-- ═══ NEW Rule 7: Merge confirmed content duplicates ═══
             These blog posts and root pages target the identical
             topic/search intent. Google indexed the root version
             and is refusing to index the blog duplicate. Redirect
             the duplicate into the canonical page so the signals
             consolidate onto one URL instead of splitting.
             VERIFY the two marked rules below match your actual
             live routes before deploying — I inferred the slugs
             from our earlier conversation, not from your router
             config directly. -->
        <rule name="RedirectDupWebsiteCost" stopProcessing="true">
          <match url="^blog/website-development-cost-in-pakistan/?$" />
          <action type="Redirect" url="/website-development-cost-in-pakistan" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupMobileCost" stopProcessing="true">
          <match url="^blog/mobile-app-development-cost-in-pakistan/?$" />
          <action type="Redirect" url="/mobile-app-development-cost-in-pakistan" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupAI" stopProcessing="true">
          <match url="^blog/ai-powered-software-solutions/?$" />
          <action type="Redirect" url="/ai-powered-software-solutions" redirectType="Permanent" />
        </rule>
        <!-- CONFIRMED live: the real page has no "-services" suffix -->
        <rule name="RedirectDupASPNET" stopProcessing="true">
          <match url="^blog/asp-net-core-development/?$" />
          <action type="Redirect" url="/asp-net-core-development" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupAngularHire" stopProcessing="true">
          <match url="^blog/hire-angular-developers-pakistan/?$" />
          <action type="Redirect" url="/hire-angular-developers-pakistan" redirectType="Permanent" />
        </rule>
        <!-- CONFIRMED live: the root page is canonical (fully indexed with real
             content). The /blog/ copy is the duplicate — redirect it INTO root. -->
        <rule name="RedirectDupOutsourceMobile" stopProcessing="true">
          <match url="^blog/outsource-mobile-app-development-to-pakistan/?$" />
          <action type="Redirect" url="/outsource-mobile-app-development-to-pakistan" redirectType="Permanent" />
        </rule>

        <!-- Rule 8: React Router — serve index.html for all non-file, non-directory routes -->
        <!-- This MUST stay the last rule -->
        <rule name="React Router SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}"      pattern="^/(api/)"      negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

      <!-- Outbound rules: add canonical header -->
      <outboundRules>
        <rule name="Add Vary Header">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
      </outboundRules>

    </rewrite>

    <!-- ═══════════════════════════════════════════════════
         2. COMPRESSION — Gzip for faster page loads (SEO)
    ═══════════════════════════════════════════════════ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/*"              enabled="true" />
        <add mimeType="message/*"           enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript"   enabled="true" />
        <add mimeType="application/json"         enabled="true" />
        <add mimeType="application/xml"          enabled="true" />
        <add mimeType="*/*"                 enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*"              enabled="true" />
        <add mimeType="message/*"           enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript"   enabled="true" />
        <add mimeType="application/json"         enabled="true" />
        <add mimeType="application/atom+xml"     enabled="true" />
        <add mimeType="application/xaml+xml"     enabled="true" />
        <add mimeType="image/svg+xml"            enabled="true" />
        <add mimeType="*/*"                 enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- ═══════════════════════════════════════════════════
         3. CACHING — Browser cache for static assets (SEO/CWV)
    ═══════════════════════════════════════════════════ -->
    <staticContent>

      <!-- MIME types for modern file formats -->
      <remove fileExtension=".json"  />
      <remove fileExtension=".webp"  />
      <remove fileExtension=".woff"  />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".svg"   />
      <remove fileExtension=".ico"   />

      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <mimeMap fileExtension=".webp"  mimeType="image/webp" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico"   mimeType="image/x-icon" />

      <!-- Cache hashed JS/CSS bundles for 1 year (React adds hash to filename) -->
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="365.00:00:00" />

    </staticContent>

    <!-- Cache headers per file type via location blocks -->
    <httpProtocol>
      <customHeaders>

        <!-- ═══════════════════════════════════════════════════
             4. SECURITY HEADERS — Trust signals + protection
        ═══════════════════════════════════════════════════ -->

        <!-- Prevent clickjacking -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- Prevent MIME type sniffing -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- XSS Protection (legacy browsers) -->
        <add name="X-XSS-Protection" value="1; mode=block" />

        <!-- Referrer Policy — send referrer on same-origin, shortened on cross-origin -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Permissions Policy — disable unused browser APIs -->
        <add name="Permissions-Policy"
             value="camera=(), microphone=(), geolocation=(), payment=()" />

        <!-- HSTS — force HTTPS for 1 year (only enable after HTTPS confirmed working) -->
        <add name="Strict-Transport-Security"
             value="max-age=31536000; includeSubDomains" />

      </customHeaders>
    </httpProtocol>

    <!-- ═══════════════════════════════════════════════════
         5. DEFAULT DOCUMENT
    ═══════════════════════════════════════════════════ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ═══════════════════════════════════════════════════
         6. CUSTOM ERROR PAGES — Serve index.html for 404
         (React Router handles the UI for unknown routes)
    ═══════════════════════════════════════════════════ -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404"
             path="/index.html"
             responseMode="ExecuteURL" />
    </httpErrors>

    <!-- ═══════════════════════════════════════════════════
         7. DIRECTORY BROWSING — Disable (security)
    ═══════════════════════════════════════════════════ -->
    <directoryBrowse enabled="false" />

  </system.webServer>

  <!-- ═══════════════════════════════════════════════════
       8. LOCATION-BASED CACHE CONTROL
       Long cache for hashed assets, no-cache for index.html
  ═══════════════════════════════════════════════════ -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <!-- Never cache index.html — always serve fresh -->
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma"        value="no-cache" />
          <add name="Expires"       value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="static">
    <system.webServer>
      <staticContent>
        <!-- Cache static/js and static/css for 1 year (they have content hash in filename) -->
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>