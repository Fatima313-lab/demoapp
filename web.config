<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     RETIRED PAGES — QUICK REFERENCE
     These 6 pages are currently 301-redirected into a pillar page
     because they had no route and were causing GSC duplicate-content
     errors. If you want to bring ANY of them back as a real page again,
     search this file for its rule name below (Ctrl+F), then follow the
     "TO REVIVE" comment sitting directly above that rule. That comment
     tells you exactly what to delete and what to add — nothing else
     in this file needs to change.

     URL                                          Rule name (search this)
     /document-control-software                   RedirectOrphanDocControl
     /custom-school-management-software-development  RedirectOrphanSchoolMgmt
     /custom-business-automation-solutions        RedirectOrphanBizAutomation
     /resources                                   RedirectOrphanResources
     /top-software-house-in-pakistan              RedirectOrphanTopSoftwareHouse
     /outsource-web-development-to-pakistan       RedirectOrphanOutsourceWeb
═══════════════════════════════════════════════════════════════════ -->
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════
         1. URL REWRITING — React Router + SEO Redirects
         Order matters. Each rule below only runs if the
         ones above it didn't already redirect the request.
    ═══════════════════════════════════════════════════ -->
    <rewrite>
      <rules>

        <!-- Rule 1: Force HTTPS (HTTP → HTTPS) -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 2: Remove WWW (www.qllmsoft.com → qllmsoft.com) -->
        <rule name="Remove WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.qllmsoft\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://qllmsoft.com/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 3: Force lowercase URLs -->
        <rule name="Lowercase URLs" stopProcessing="true">
          <match url=".*[A-Z].*" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="{ToLower:{URL}}" redirectType="Permanent" />
        </rule>

        <!-- Rule 4: Remove trailing slash (except root /) -->
        <rule name="Remove Trailing Slash" stopProcessing="true">
          <match url="(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- Rule 5: Remove .html extension -->
        <rule name="Remove HTML Extension" stopProcessing="true">
          <match url="^(.*?)\.html$" />
          <action type="Redirect" url="/{R:1}"
                  redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             Rule 6: Retire the old /blog-post/ URL structure
             UPDATED 2026-08-11 — the previous version of this
             rule set (5 slugs) did NOT match any of the 21 URLs
             Search Console actually flagged as duplicates. This
             version covers the 9 real GSC-flagged /blog-post/
             URLs, plus keeps the original 5 since they may still
             have backlinks pointing at them.

             CONFIDENT matches (title/topic clearly the same post,
             just renamed during migration) vs FALLBACK matches
             (no equivalent found — sent to /blog index rather than
             guessing a slug) are marked below. Verify the FALLBACK
             ones against your actual blogPostsData before deploying
             — if a real equivalent exists, tell me and I'll point
             these at the specific post instead of the blog index.
        ═══════════════════════════════════════════════════ -->

        <!-- Original 5 (kept in case of existing backlinks) -->
        <rule name="RedirectOldBlogPost1" stopProcessing="true">
          <match url="^blog-post/legacy-system-modernization-cost-in-2026/?$" />
          <action type="Redirect" url="/blog/legacy-system-modernization-without-downtime-or-data-loss" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost2" stopProcessing="true">
          <match url="^blog-post/mobile-app-devsecops/?$" />
          <action type="Redirect" url="/blog/mobile-app-devsecops-in-2026" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost3" stopProcessing="true">
          <match url="^blog-post/role-based-access-ecommerce-operations/?$" />
          <action type="Redirect" url="/blog/role-based-access-problems-why-teams-break-systems" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost4" stopProcessing="true">
          <match url="^blog-post/how-we-build-secure-web-apps/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost5" stopProcessing="true">
          <match url="^blog-post/what-makes-a-great-mobile-app/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>

        <!-- The 9 actually flagged by GSC -->
        <!-- CONFIDENT: clear title/topic match -->
        <rule name="RedirectOldBlogPost6" stopProcessing="true">
          <match url="^blog-post/security-challenges-scalable-ecommerce-smbs/?$" />
          <action type="Redirect" url="/blog/scalable-ecommerce-development-for-smbs" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost7" stopProcessing="true">
          <match url="^blog-post/website-development-cost-in-pakistan/?$" />
          <action type="Redirect" url="/website-development-cost-in-pakistan" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost8" stopProcessing="true">
          <match url="^blog-post/custom-vs-saas-ecommerce-platforms-for-growing-businesses/?$" />
          <action type="Redirect" url="/blog/custom-vs-saas-ecommerce-for-growing-smbs" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost9" stopProcessing="true">
          <match url="^blog-post/legacy-system-modernization-vs-rebuilding/?$" />
          <action type="Redirect" url="/blog/legacy-system-modernization-without-downtime-or-data-loss" redirectType="Permanent" />
        </rule>

        <!-- FALLBACK: no confirmed equivalent found — verify against blogPostsData -->
        <rule name="RedirectOldBlogPost10" stopProcessing="true">
          <match url="^blog-post/custom-software-business-growth-2026/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost11" stopProcessing="true">
          <match url="^blog-post/top-5-tools-for-agile-teams/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost12" stopProcessing="true">
          <match url="^blog-post/why-custom-software-is-the-future/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost13" stopProcessing="true">
          <match url="^blog-post/pakistani-businesses-go-global-tech-strategy/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>
        <rule name="RedirectOldBlogPost14" stopProcessing="true">
          <match url="^blog-post/mobile-app-performance-optimization/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             Rule 7: Root-level ghost duplicates of real /blog/ posts
             These URLs have NO matching <Route> in App.jsx at all —
             they render a blank SPA shell (200 status, no content),
             which is why Google flags them as duplicates of the
             real /blog/ post instead of dropping them as 404s.
        ═══════════════════════════════════════════════════ -->
        <rule name="RedirectRootGhost1" stopProcessing="true">
          <match url="^csharp-desktop-application-development/?$" />
          <action type="Redirect" url="/blog/csharp-desktop-application-development" redirectType="Permanent" />
        </rule>
        <rule name="RedirectRootGhost2" stopProcessing="true">
          <match url="^scalable-ecommerce-development-for-smbs/?$" />
          <action type="Redirect" url="/blog/scalable-ecommerce-development-for-smbs" redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             Rule 8: Merge confirmed /blog/ vs root content duplicates
             UPDATED — RedirectDupASPNET destination was WRONG in the
             previous version: it pointed to /asp-net-core-development,
             which has no <Route> in App.jsx. The real, live route is
             /asp-net-core-development-services. Fixed below.
        ═══════════════════════════════════════════════════ -->
        <rule name="RedirectDupWebsiteCost" stopProcessing="true">
          <match url="^blog/website-development-cost-in-pakistan/?$" />
          <action type="Redirect" url="/website-development-cost-in-pakistan" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupMobileCost" stopProcessing="true">
          <match url="^blog/mobile-app-development-cost-in-pakistan/?$" />
          <action type="Redirect" url="/mobile-app-development-cost-in-pakistan" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupAI" stopProcessing="true">
          <match url="^blog/ai-powered-software-solutions/?$" />
          <action type="Redirect" url="/ai-powered-software-solutions" redirectType="Permanent" />
        </rule>
        <!-- FIXED: destination corrected to the route that actually exists -->
        <rule name="RedirectDupASPNET" stopProcessing="true">
          <match url="^blog/asp-net-core-development/?$" />
          <action type="Redirect" url="/asp-net-core-development-services" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupAngularHire" stopProcessing="true">
          <match url="^blog/hire-angular-developers-pakistan/?$" />
          <action type="Redirect" url="/hire-angular-developers-pakistan" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDupOutsourceMobile" stopProcessing="true">
          <match url="^blog/outsource-mobile-app-development-to-pakistan/?$" />
          <action type="Redirect" url="/outsource-mobile-app-development-to-pakistan" redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             Rule 9: Bare ghost URL for ASP.NET page
             /asp-net-core-development (no "-services") is not a
             route — it's an orphaned URL Google indexed with thin
             content. Send it to the real page.
        ═══════════════════════════════════════════════════ -->
        <rule name="RedirectBareASPNET" stopProcessing="true">
          <match url="^asp-net-core-development/?$" />
          <action type="Redirect" url="/asp-net-core-development-services" redirectType="Permanent" />
        </rule>

        <!-- ═══════════════════════════════════════════════════
             Rule 10: Retire orphaned pages with no route in App.jsx
             Confirmed dead — merged into closest existing pillar.
             Each rule below is self-contained: to revive that page,
             just follow its own "TO REVIVE" comment. See the quick-
             reference table at the very top of this file to find
             the right rule fast.
        ═══════════════════════════════════════════════════ -->

        <!-- TO REVIVE /document-control-software:
             1. Delete this <rule> block entirely.
             2. In App.jsx: add a lazy import + <Route path="/document-control-software" .../>
                pointing at the (rebuilt) DocumentControlSoftware page component.
             3. Add /document-control-software back into sitemap.xml with today's lastmod.
             4. Link it from /custom-software-development-services (1-2 links down, per
                architecture PDF's linking rule) — don't scatter links from unrelated pages.
             5. Submit the URL in GSC's URL Inspection tool for re-crawl. -->
        <rule name="RedirectOrphanDocControl" stopProcessing="true">
          <match url="^document-control-software/?$" />
          <action type="Redirect" url="/custom-software-development-services" redirectType="Permanent" />
        </rule>

        <!-- TO REVIVE /custom-school-management-software-development:
             1. Delete this <rule> block entirely.
             2. In App.jsx: add a lazy import + <Route path="/custom-school-management-software-development" .../>
             3. Add it back into sitemap.xml with today's lastmod.
             4. Link it from /education-software-development-pakistan (its vertical parent).
             5. Submit the URL in GSC's URL Inspection tool for re-crawl. -->
        <rule name="RedirectOrphanSchoolMgmt" stopProcessing="true">
          <match url="^custom-school-management-software-development/?$" />
          <action type="Redirect" url="/education-software-development-pakistan" redirectType="Permanent" />
        </rule>

        <!-- TO REVIVE /custom-business-automation-solutions:
             1. Delete this <rule> block entirely.
             2. In App.jsx: add a lazy import + <Route path="/custom-business-automation-solutions" .../>
             3. Add it back into sitemap.xml with today's lastmod.
             4. Link it from /custom-software-development-services.
             5. Submit the URL in GSC's URL Inspection tool for re-crawl. -->
        <rule name="RedirectOrphanBizAutomation" stopProcessing="true">
          <match url="^custom-business-automation-solutions/?$" />
          <action type="Redirect" url="/custom-software-development-services" redirectType="Permanent" />
        </rule>

        <!-- TO REVIVE /resources:
             1. Delete this <rule> block entirely.
             2. In App.jsx: add a lazy import + <Route path="/resources" .../>
             3. Add it back into sitemap.xml with today's lastmod.
             4. Decide what this page is FOR before reviving it — it had no clear
                intent last time, which is partly why it collided with /blog.
                Define a distinct purpose (e.g. downloadable guides/templates
                index) so it doesn't just re-duplicate /blog again.
             5. Submit the URL in GSC's URL Inspection tool for re-crawl. -->
        <rule name="RedirectOrphanResources" stopProcessing="true">
          <match url="^resources/?$" />
          <action type="Redirect" url="/blog" redirectType="Permanent" />
        </rule>

        <!-- TO REVIVE /top-software-house-in-pakistan:
             CAUTION: your architecture PDF explicitly names /best-software-house-in-pakistan
             as the ONE AND ONLY page allowed this search intent. Reviving this as a
             separate page will re-create the exact cannibalization it was retired to fix.
             Only proceed if you're deliberately replacing /best-software-house-in-pakistan
             with this URL instead of running both.
             1. Delete this <rule> block entirely.
             2. In App.jsx: add a lazy import + <Route path="/top-software-house-in-pakistan" .../>
             3. Add it back into sitemap.xml with today's lastmod.
             4. Submit the URL in GSC's URL Inspection tool for re-crawl. -->
        <rule name="RedirectOrphanTopSoftwareHouse" stopProcessing="true">
          <match url="^top-software-house-in-pakistan/?$" />
          <action type="Redirect" url="/best-software-house-in-pakistan" redirectType="Permanent" />
        </rule>

        <!-- TO REVIVE /outsource-web-development-to-pakistan:
             CAUTION: this overlaps /outsource-software-development-to-pakistan's intent.
             Only revive if you give it a genuinely distinct angle (e.g. web-specifically,
             vs. the general outsourcing pillar) — otherwise it'll re-cannibalize.
             1. Delete this <rule> block entirely.
             2. In App.jsx: add a lazy import + <Route path="/outsource-web-development-to-pakistan" .../>
             3. Add it back into sitemap.xml with today's lastmod.
             4. Link it from /outsource-software-development-to-pakistan as a sibling,
                per the architecture PDF's Industry & Outsourcing Cluster rules.
             5. Submit the URL in GSC's URL Inspection tool for re-crawl. -->
        <rule name="RedirectOrphanOutsourceWeb" stopProcessing="true">
          <match url="^outsource-web-development-to-pakistan/?$" />
          <action type="Redirect" url="/outsource-software-development-to-pakistan" redirectType="Permanent" />
        </rule>

        <!-- Rule 11: React Router — serve index.html for all non-file, non-directory routes -->
        <!-- This MUST stay the last rule -->
        <rule name="React Router SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}"      pattern="^/(api/)"      negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

      <!-- Outbound rules: add canonical header -->
      <outboundRules>
        <rule name="Add Vary Header">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
      </outboundRules>

    </rewrite>

    <!-- ═══════════════════════════════════════════════════
         2. COMPRESSION — Gzip for faster page loads (SEO)
    ═══════════════════════════════════════════════════ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/*"              enabled="true" />
        <add mimeType="message/*"           enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript"   enabled="true" />
        <add mimeType="application/json"         enabled="true" />
        <add mimeType="application/xml"          enabled="true" />
        <add mimeType="*/*"                 enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*"              enabled="true" />
        <add mimeType="message/*"           enabled="true" />
        <add mimeType="application/x-javascript" enabled="true" />
        <add mimeType="application/javascript"   enabled="true" />
        <add mimeType="application/json"         enabled="true" />
        <add mimeType="application/atom+xml"     enabled="true" />
        <add mimeType="application/xaml+xml"     enabled="true" />
        <add mimeType="image/svg+xml"            enabled="true" />
        <add mimeType="*/*"                 enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- ═══════════════════════════════════════════════════
         3. CACHING — Browser cache for static assets (SEO/CWV)
    ═══════════════════════════════════════════════════ -->
    <staticContent>

      <!-- MIME types for modern file formats -->
      <remove fileExtension=".json"  />
      <remove fileExtension=".webp"  />
      <remove fileExtension=".woff"  />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".svg"   />
      <remove fileExtension=".ico"   />

      <mimeMap fileExtension=".json"  mimeType="application/json" />
      <mimeMap fileExtension=".webp"  mimeType="image/webp" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <mimeMap fileExtension=".ico"   mimeType="image/x-icon" />

      <!-- Cache hashed JS/CSS bundles for 1 year (React adds hash to filename) -->
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="365.00:00:00" />

    </staticContent>

    <!-- Cache headers per file type via location blocks -->
    <httpProtocol>
      <customHeaders>

        <!-- ═══════════════════════════════════════════════════
             4. SECURITY HEADERS — Trust signals + protection
        ═══════════════════════════════════════════════════ -->

        <!-- Prevent clickjacking -->
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <!-- Prevent MIME type sniffing -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- XSS Protection (legacy browsers) -->
        <add name="X-XSS-Protection" value="1; mode=block" />

        <!-- Referrer Policy — send referrer on same-origin, shortened on cross-origin -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Permissions Policy — disable unused browser APIs -->
        <add name="Permissions-Policy"
             value="camera=(), microphone=(), geolocation=(), payment=()" />

        <!-- HSTS — force HTTPS for 1 year (only enable after HTTPS confirmed working) -->
        <add name="Strict-Transport-Security"
             value="max-age=31536000; includeSubDomains" />

      </customHeaders>
    </httpProtocol>

    <!-- ═══════════════════════════════════════════════════
         5. DEFAULT DOCUMENT
    ═══════════════════════════════════════════════════ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ═══════════════════════════════════════════════════
         6. CUSTOM ERROR PAGES — Serve index.html for 404
         (React Router handles the UI for unknown routes)
    ═══════════════════════════════════════════════════ -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404"
             path="/index.html"
             responseMode="ExecuteURL" />
    </httpErrors>

    <!-- ═══════════════════════════════════════════════════
         7. DIRECTORY BROWSING — Disable (security)
    ═══════════════════════════════════════════════════ -->
    <directoryBrowse enabled="false" />

  </system.webServer>

  <!-- ═══════════════════════════════════════════════════
       8. LOCATION-BASED CACHE CONTROL
       Long cache for hashed assets, no-cache for index.html
  ═══════════════════════════════════════════════════ -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <!-- Never cache index.html — always serve fresh -->
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma"        value="no-cache" />
          <add name="Expires"       value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <location path="static">
    <system.webServer>
      <staticContent>
        <!-- Cache static/js and static/css for 1 year (they have content hash in filename) -->
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="public, max-age=31536000, immutable" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

</configuration>
